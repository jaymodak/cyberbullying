FROM python:3.10

# Set working directory
WORKDIR /app

# Copy all files into container
COPY . .

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# 🔥 Cache ML models (VERY IMPORTANT)
ENV TRANSFORMERS_CACHE=/app/cache

# Pre-download models to avoid runtime delay
RUN python -c "from transformers import pipeline; pipeline('text-classification', model='unitary/toxic-bert')"

# Expose HuggingFace required port
EXPOSE 7860

# Start Flask app
CMD ["python", "app.py"]